# Mureka API — keep the secret key server-side only
MUREKA_API_KEY=
# Keep false until the Mureka API is configured and a test generation is verified.
MUSIC_GENERATION_ENABLED=false

# Supabase (authentication and persistent track library; not wired yet)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack payments (not wired yet; secret values stay server-side)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Public app URL, e.g. https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
