# Official Suno API access (sign in at https://platform.suno.com/)
# Use only the base URL, model and auth format provided by Suno in your account/docs.
SUNO_API_BASE_URL=
SUNO_API_KEY=
SUNO_API_MODEL=
SUNO_API_ACCESS_CONFIRMED=false

# Authentication/database provider (not connected yet)
DATABASE_URL=
AUTH_SECRET=

# Payments (keep secret keys server-side; never commit real keys)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Public app URL, e.g. https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
